# ARTI — environment template
# Copy to `.env.local` (local) or configure in the Vercel dashboard (deployed).
# Never commit a real `.env*` file other than this template.

# ---------------------------------------------------------------------------
# Public configuration (exposed to the browser, safe to publish)
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key. This is designed to be public, but row level
# security must still be enabled on every table that stores private data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL used for canonical links and the PWA manifest.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only configuration (never exposed to the browser)
# ---------------------------------------------------------------------------

# Supabase service role key. Bypasses row level security: server-side use only.
# Leave blank unless a specific server task genuinely requires it.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the FastAPI backend, used by server-side route handlers.
ARTI_API_BASE_URL=http://localhost:8000
